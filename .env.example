# Copy to .env and fill in what you need.
#
# The database is OPTIONAL. Leave DATABASE_URL unset (or empty) to run in
# demo mode: parsing, dashboards and exports work, but import history and
# learned column names are not saved.
#
# With a database:
#   1. DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
#   2. npx drizzle-kit push     (creates import_batches + column_aliases)
#
# Local development default:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Required for saving imports (optional for a demo deploy)
DATABASE_URL=
